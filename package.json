{
  "name": "homebridge-verisure",
  "version": "3.0.0",
  "description": "Verisure plugin for Homebridge: https://homebridge.io",
  "license": "MIT",
  "keywords": [
    "homebridge-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/ptz0n/homebridge-verisure.git"
  },
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.com/paypalme/ptz0n"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/bin/verisure.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "rimraf dist && tsc && chmod +x dist/bin/verisure.js",
    "watch": "tsc --watch",
    "lint": "eslint src",
    "test": "npm run lint && npm run build && jest --coverage",
    "start": "npm run build && homebridge -P . -D"
  },
  "bugs": {
    "url": "http://github.com/ptz0n/homebridge-verisure/issues"
  },
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "enquirer": "^2.3.6",
    "verisure": "^5.1.2"
  },
  "overrides": {
    "@homebridge/hap-nodejs": "$@homebridge/hap-nodejs"
  },
  "devDependencies": {
    "@homebridge/hap-nodejs": "^2.2.3",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^28.9.0",
    "homebridge": "^2.0.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
